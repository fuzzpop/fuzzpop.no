
RewriteEngine on
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^fuzzpop\.no$ [OR]
RewriteCond %{HTTP_HOST} ^www\.fuzzpop\.no$
RewriteRule ^(.*)$ "https\:\/\/fuzzpop\.no\/$1" [R=301,L]
Options -MultiViews
DirectorySlash Off
RewriteCond %{THE_REQUEST} "\s/+index\.php[?\s]" [NC]
RewriteRule ^index\.php$ / [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+(disco|disco_grid|disco_table|disco_details)\.php[?\s]" [NC]
RewriteRule ^(disco|disco_grid|disco_table|disco_details)\.php$ /$1 [R=301,L]
RewriteRule ^(disco|disco_grid|disco_table|disco_details)/$ /$1 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(disco|disco_grid|disco_table|disco_details)$ $1.php [END]
